From 3b4166d581b93ef9c3334d4a994c883045a40632 Mon Sep 17 00:00:00 2001
From: Amr Fateem <amr.fateem@yahoo.com>
Date: Wed, 11 Nov 2026 09:01:54 +0200
Subject: [PATCH] openwrt: keep the LAN bridge and DNS defaults safe

OpenWrt's LAN is a bridge.  v2rayA 2.5.x excludes br-* from the
transparent proxy by default, which silently bypasses every LAN client.
The previous OpenWrt package also did not hijack DNS, and nodes that do
not carry UDP break client DNS when it is enabled.

Keep the previous behaviour, and size the logging, sniffing and DNS cache
for a router.  Carrying this as a patch makes a source change fail the
build instead of silently dropping the defaults.

Signed-off-by: Amr Fateem <amr.fateem@yahoo.com>
---
 db/configure/migrate_dns.go |  2 +-
 db/configure/setting.go     | 14 +++++++-------
 2 files changed, 8 insertions(+), 8 deletions(-)

--- a/db/configure/migrate_dns.go
+++ b/db/configure/migrate_dns.go
@@ -61,7 +61,7 @@ func MigrateDnsRules(oldRules []DnsRule)
 func MigrateSetting(setting *Setting) {
 	// DNS interception keeps the historical behaviour when the field is absent.
 	if setting.DnsHijack == "" {
-		setting.DnsHijack = Yes
+		setting.DnsHijack = No
 	}
 	// The mode supersedes the opt-out, so an absent one is written out from
 	// it once; after this the stored mode is what every reader uses.
--- a/db/configure/setting.go
+++ b/db/configure/setting.go
@@ -51,7 +51,7 @@ type Setting struct {
 
 func NewSetting() (setting *Setting) {
 	return &Setting{
-		LogLevel:                           "info",
+		LogLevel:                           "warn",
 		RulePortMode:                       WhitelistMode,
 		ProxyModeWhenSubscribe:             ProxyModeDirect,
 		GFWListAutoUpdateMode:              NotAutoUpdate,
@@ -61,22 +61,22 @@ func NewSetting() (setting *Setting) {
 		TcpFastOpen:                        Default,
 		MuxOn:                              No,
 		Mux:                                8,
-		InboundSniffing:                    "http,tls,quic",
+		InboundSniffing:                    "http,tls",
 		Transparent:                        TransparentClose,
-		DnsHijack:                          Yes,
+		DnsHijack:                          No,
 		IpForward:                          ipforward.IsIpForwardOn(),
 		PortSharing:                        false,
 		TransparentType:                    TransparentRedirect,
-		TproxyExcludedInterfaces:           "docker*,veth*,wg*,ppp*,br-*",
+		TproxyExcludedInterfaces:           "docker*,veth*,wg*,ppp*",
 		TunAutoRoute:                       true,
 		// 新 DNS 模块默认值
 		DnsListenAddr:    "0.0.0.0:52353",
 		DnsCacheEnabled:  true,
-		DnsCacheSize:     4096,
+		DnsCacheSize:     1024,
 		DnsCacheMinTTL:   60,
 		DnsCacheMaxTTL:   86400,
-		DnsPrefetch:      true,
-		DnsNegativeCache: true,
+		DnsPrefetch:      false,
+		DnsNegativeCache: false,
 	}
 }
 
